[Unit]
Description=Graduation project Go API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/graduation-project
EnvironmentFile=/etc/graduation-project/runtime.env
ExecStart=/usr/local/bin/graduation-project
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
