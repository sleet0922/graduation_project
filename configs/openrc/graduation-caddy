#!/sbin/openrc-run

name="graduation-project Caddy"
command="/usr/sbin/caddy"
command_args="run --config /etc/caddy/Caddyfile --adapter caddyfile"
command_background="yes"
pidfile="/run/$RC_SVCNAME.pid"
output_log="/var/log/caddy.log"
error_log="/var/log/caddy.log"

depend() {
	need net graduation-project livekit
	after graduation-project livekit
}

load_env() {
	if [ -r /etc/bocker.env ]; then
		set -a
		. /etc/bocker.env
		set +a
	fi
}

start_pre() {
	load_env
	local domain="${BOCKER_DOMAIN:-graduation-project.test}"
	local mode="${BOCKER_TLS_MODE:-local}"
	local cert="${BOCKER_TLS_CERT:-/var/lib/graduation-project/tls/server.pem}"
	local key="${BOCKER_TLS_KEY:-/var/lib/graduation-project/tls/server.key}"
	export BOCKER_DOMAIN="$domain" BOCKER_TLS_CERT="$cert" BOCKER_TLS_KEY="$key"
	checkpath -d -m 0755 /var/lib/graduation-project "$(dirname "$cert")"
	case "$mode" in
		local)
			if [ ! -s "$cert" ] || [ ! -s "$key" ] || ! openssl x509 -in "$cert" -noout >/dev/null 2>&1 || ! openssl pkey -in "$key" -noout >/dev/null 2>&1; then
				rm -f "$cert" "$key"
				openssl req -x509 -newkey rsa:2048 -nodes -days 7 \
					-keyout "$key" -out "$cert" \
					-subj "/CN=$domain" \
					-addext "basicConstraints=critical,CA:FALSE" \
					-addext "subjectAltName=DNS:$domain,IP:127.0.0.1" >/dev/null 2>&1 || return 1
				chmod 0600 "$key"
			fi
			;;
		production)
			[ -r "$cert" ] || { eerror "TLS certificate is not readable: $cert"; return 1; }
			[ -r "$key" ] || { eerror "TLS key is not readable: $key"; return 1; }
			openssl x509 -in "$cert" -noout >/dev/null 2>&1 || { eerror "TLS certificate is invalid"; return 1; }
			openssl pkey -in "$key" -noout >/dev/null 2>&1 || { eerror "TLS key is invalid"; return 1; }
			;;
		*) eerror "BOCKER_TLS_MODE must be local or production"; return 1 ;;
	esac
}
