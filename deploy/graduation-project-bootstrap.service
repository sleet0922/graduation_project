[Unit]
Description=Graduation project PostgreSQL bootstrap
After=postgresql@18-main.service redis-server.service
Requires=postgresql@18-main.service redis-server.service
Before=graduation-project.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/graduation-project-bootstrap
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
